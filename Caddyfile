gradientbattle.com {
	encode zstd gzip

	handle /ws {
		reverse_proxy battle:3001
	}

	handle {
		# Caps the request body a client can push into the Next.js app. Every POST
		# here is small JSON (optimizer configs, auth callbacks); the large payloads
		# are responses, which this does not touch. Without it an unauthenticated
		# body streams into the route handler unbounded.
		request_body {
			max_size 1MB
		}

		reverse_proxy web:3000
	}
}

www.gradientbattle.com {
	redir https://gradientbattle.com{uri} permanent
}
