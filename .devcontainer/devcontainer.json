{
  "name": "GradientBattle Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspace",
  // Host networking so the container's `localhost` is the host's. The app hardcodes
  // localhost for its backing services (redis://localhost:6379 in lib/redisClient.ts,
  // localhost:5433 for Postgres in .env); on the default bridge network neither is
  // reachable from inside the container. Requires a container rebuild to take effect.
  "runArgs": ["--network=host"],
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "source=gradientbattle-pnpm-store,target=/pnpm-store,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "editor.formatOnSave": true,
        // Under host networking the container's ports already are the host's, so
        // forwarding is pure downside: VS Code holds the forwarded socket open on the
        // host, and the container is then refused when it tries to bind that same port.
        // `restoreForwardedPorts` matters as much as `autoForwardPorts` — forwards are
        // remembered per workspace and re-established on attach, so a reload alone
        // brings them back.
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": false
      }
    }
  },
  "postCreateCommand": "corepack enable && pnpm install"
}
