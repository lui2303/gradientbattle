{
  "permissions": {
    "allow": [
      "Bash(timeout 60 pnpm dev)",
      "Bash(sudo -n rm -rf .next)",
      "Bash(echo \"exit: $?\")",
      "Bash(timeout 70 pnpm dev)",
      "Bash(curl -s -o /dev/null -w \"/ -> %{http_code}\\\\n\" http://localhost:3002/)",
      "Bash(curl -s -o /dev/null -w \"/battle -> %{http_code}\\\\n\" http://localhost:3002/battle)",
      "Bash(curl -s -o /dev/null -w \"/login -> %{http_code}\\\\n\" http://localhost:3002/login)",
      "Read(//tmp/**)",
      "Bash(pkill -f \"next dev\")",
      "Bash(cat package.json)",
      "Bash(cat pnpm-workspace.yaml)",
      "Bash(grep -rln \"redis\" apps --include=*.ts --include=*.tsx)",
      "Bash(sed 's/=.*/=.../' apps/web/.env)",
      "Bash(chmod +x dev.sh)",
      "Bash(bash -n dev.sh)",
      "Bash(npx prisma *)"
    ]
  }
}
