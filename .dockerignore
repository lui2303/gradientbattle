**/node_modules
**/.next
**/.next.*
apps/web/generated
.git
.github
.devcontainer
.claude
.vscode
.pnpm-store
# `*.env` only matches names ENDING in .env — .env.production would slip through.
**/.env
**/.env.*
!**/.env.*.example
**/*.db
**/coverage
docker-compose*.yaml
Caddyfile
dev.sh

# Private keys must never live in the repo — real ones belong in ~/.ssh.
# These patterns are a safety net, not a place to put them.
id_*
!id_*.pub
*.pem
*.key
