// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Run {
  id          String   @id @default(uuid())
  optimizers  Json
  steps       Int
  funcName    String
  bestRun     Json?
  createdAt   DateTime @default(now())
  lastIterate Json
}

model Battle {
  id        String   @id @default(uuid())
  startedAt DateTime @default(now())
  status    String

  player1Id String
  player1   User   @relation("BattlePlayer1", fields: [player1Id], references: [id])

  player2Id String
  player2   User   @relation("BattlePlayer2", fields: [player2Id], references: [id])
  winnerId  String?

  winner    User?  @relation("BattleWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  game      Json

  battleRuns BattleRun[]
}

model BattleRun {
  id          String   @id @default(uuid())

  playerId String
  player   User   @relation("BattleRunPlayer", fields: [playerId], references: [id])

  battleID String
  battle   Battle @relation(fields: [battleID], references: [id], onDelete: Cascade)

  optimizers  Json
  lastIterate Json
  createdAt   DateTime @default(now())

  iterations Int
}

model ChallengeRun {
  id          String   @id @default(uuid())
  username    String
  optimizers  Json
  lastIterate Json
  createdAt   DateTime @default(now())

  challengeID Int // required now — every row belongs to a challenge
  challenge   Challenge @relation(fields: [challengeID], references: [id], onDelete: Cascade)

  iterations Int
}

model Challenge {
  id            Int            @id @default(autoincrement())
  name          String
  params        Json?
  createdAt     DateTime       @default(now())
  challengeRuns ChallengeRun[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  elo           Int       @default(400)
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  battlesAsPlayer1 Battle[] @relation("BattlePlayer1")
  battlesAsPlayer2 Battle[] @relation("BattlePlayer2")
  battlesWon       Battle[] @relation("BattleWinner")
  battleRuns       BattleRun[] @relation("BattleRunPlayer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
